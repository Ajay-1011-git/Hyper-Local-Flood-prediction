DATABASE_URL=postgresql://localhost:5432/floodsystem
REDIS_URL=redis://localhost:6379/0
HAZARD_THRESHOLD_DEPTH_M=0.3        # config value, human-reviewable, not verified-optimal

# ---- T3.6: Stage 2 integration ----
# Base URL for Stage 2's real GET /api/simulation/site/{site_id} endpoint
# (stage2 build doc T2.9). Left blank until Ajay's Stage 2 has a running
# deployment to point at -- routes.py falls back to an explicitly-labeled
# mock SimulationResult fixture when this is unset, same pattern as Stage
# 1B's STAGE1A_REGIONAL_FORECAST_URL before Stage 1A went live.
STAGE2_SIMULATION_RESULT_BASE_URL=
DAMAGE_RANKING_CACHE_TTL_SECONDS=3600   # unverified default, see config.py
# VULNERABILITY_CURVE_SOURCE intentionally has no line here: a blank
# `VAR=` in a .env file is still a *set* value (empty string), which
# would override config.py's real default (the actual T3.4 citation,
# vulnerability/fragility_curve.py's VULNERABILITY_CURVE_SOURCE) with
# nothing. Leave this var entirely absent from .env to use the real
# default; only add a real `VULNERABILITY_CURVE_SOURCE=...` line here if
# a human is deliberately overriding it with a different confirmed
# source.
