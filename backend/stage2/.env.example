SITE_GLB_PATH=./blender_prep/output/vit_vellore_site.glb
SITE_ANCHOR_JSON_PATH=./blender_prep/output/anchor_point.json
DEM_SOURCE=stage1b   # pulled from Stage 1B's persisted DEM, not refetched here
MSWE_GNN_PRETRAINED_PATH=            # path to pretrained weights if found in RBTV1/mSWE-GNN repo
# T2.6, 2026-08-20 amendment: confirmed no pretrained checkpoint exists for
# the single-scale SWEGNN architecture this project uses (the only
# downloadable weights are for the multiscale MSGNN variant -- see
# gnn/model.py's module docstring). This var is left unset; the model
# trains from a random init on T2.5's solver-generated data instead.
TERRAIN_GRID_RESOLUTION_M=1.0        # fine-grid spacing for the site terrain, in meters
TORCH_DEVICE_PREFERENCE=mps          # falls back to cpu automatically if unavailable (see gnn/device.py)
DATABASE_URL=postgresql://localhost:5432/floodsystem
# Read-only access to Stage 1B's dem_metadata table (T2.2) -- no
# HTTP API exists for DEM data, confirmed by reading stage1b/routes.py.
STAGE1B_DATABASE_URL=postgresql://localhost:5432/floodsystem
REDIS_URL=redis://localhost:6379/0
# T2.8, 2026-08-20: the ESP32/HC-SR04 hardware unit has not been
# physically placed yet -- left unset rather than a fabricated location.
# The live-sensor-assimilation endpoint exists and is wired (T2.9) but
# returns a clear error until these are set to real values.
SENSOR_TARGET_X_M=
SENSOR_TARGET_Y_M=
SENSOR_MOUNT_HEIGHT_M=
