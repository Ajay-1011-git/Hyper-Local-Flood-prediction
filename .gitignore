# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# Env / secrets
.env
.env.local
firmware/**/secrets.h

# Data / large artifacts — keep the directory tree, ignore contents
data/**
!data/**/
!**/.gitkeep
backend/stage1b/data/
*.tif
*.tiff
*.npy
*.nc
*.zarr/
*.glb
backend/stage2/blender_prep/output/**
!backend/stage2/blender_prep/output/**/
!backend/stage2/blender_prep/output/.gitkeep
!backend/stage2/blender_prep/output/README.md

# Editors / OS
.DS_Store
.vscode/
.idea/

# run_all.sh output
/logs/

# Path shim run_all.sh creates so DEM paths stored relative to the repo
# root also resolve for the stages that must run from backend/. A symlink
# into gitignored data -- recreated on demand, never committed.
/backend/data/

# cfgrib writes a per-file index cache beside any GRIB2 it opens.
# Generated artifact, not a fixture -- never commit it.
*.grib2.*.idx

# Stage 4 VERIFY screenshots -- real headless-browser output, regenerated
# on demand by frontend/scripts/verify-screenshot.mjs. Real evidence for
# the build docs' VERIFY steps, but not source; kept out of the repo the
# same way data/ artifacts are.
verify_screenshots/
