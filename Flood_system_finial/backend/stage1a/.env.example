# ---- GEFS (NOAA Global Ensemble Forecast System, 0.25deg) ----
# 2026-08-20 amendment: GEFS is now the PRIMARY regional-forecast source
# (WeatherNext 2 Mini is the fallback). Fully automated, no manual step,
# and 0.25deg native resolution vs WN2 Mini's 1.0deg -- the reason for
# the switch. All values below default to these same settings in
# config.py; blank falls through to the default.
#
# PRIMARY transport: NOAA Open Data Dissemination on S3 (no rate limits).
GEFS_S3_BASE_URL=https://noaa-gefs-pds.s3.amazonaws.com
# FALLBACK transport: NOMADS's GRIB-filter CGI (server-side subsetting,
# far less bandwidth, but a shared rate-limited service).
GEFS_FILTER_BASE_URL=https://nomads.ncep.noaa.gov/cgi-bin/filter_gefs_atmos_0p25s.pl
# NOAA publishes a cycle a few hours after its nominal time; requesting
# too soon returns a real "not yet published" response. FLAG FOR HUMAN
# REVIEW -- conservative default, not NOAA's published SLA.
GEFS_PUBLICATION_LAG_HOURS=5.0
# How many 6-hourly cycles to step back through before giving up and
# falling through to WeatherNext 2 Mini.
GEFS_CYCLE_RETRIES=4
GEFS_MAX_CONCURRENT_REQUESTS=5
GEFS_REQUEST_TIMEOUT_S=20.0

# ---- WeatherNext 2 Cyclones Mini (regional ensemble weather forecast) ----
# 2026-08-20: now the SECONDARY/fallback source, used only when GEFS is
# unavailable (see the GEFS block above).
# Manually exported from wn2_demo.ipynb (Colab) and copied here ahead of
# time; the backend never runs inference itself. See
# data/wn2_mini/README.md for the confirmed export pipeline.
WN2_MINI_FORECAST_PATH=./data/wn2_mini/tn_flood_forecast.nc

# ---- CWC / India-WRIS (river & reservoir stage forecast) ----
# Confirmed in T1A.6: National Water Data Portal is a CKAN instance at this
# base URL (its /api/3/action/... Action API). Blank falls through to the
# same default in config.py.
CWC_DATA_PORTAL_BASE_URL=https://nwdp.nwic.gov.in
# indiawris.gov.in resolves (164.100.85.36) but every TCP connection to it
# times out from this dev environment -- likely a geo/IP-level block, not a
# credentials problem. The real backend the official India-WRIS Angular app
# actually calls (reverse-engineered from its JS bundle, served from the
# reachable mirror at nwic.in/wris/) is a DIFFERENT host, confirmed
# reachable with real reference data (GET /getStatesListDataViewPage/ and
# /getMasterAgencyListDataViewPage/ both return real lists -- Tamil Nadu is
# stateCode 22, CWC is agencyId 41).
#
# NOT wired into cwc/client.py: the real station/time-series endpoints
# (/searchStationbasedStateForIWRIS/{4 params}, /stationChacteristics/{id},
# etc. -- nothing named reservoir_stations/rp_stations/gwl_stations/etc.
# exists on this backend) take positional parameters whose meaning could
# not be confirmed by probing: swapping the "stationType" argument returned
# the same data at every value tried, and no call site with real argument
# values was found in the downloaded JS chunks. Do not call this API from
# code until that shape is actually confirmed (official docs, or watching
# real browser network traffic against the live app) -- CWC/NWDP already
# covers this project's real river-stage need with a fully confirmed,
# tested integration.
INDIA_WRIS_BASE_URL=https://india-water.gov.in/eswis-api

# ---- Storage ----
DATABASE_URL=postgresql://floodsystem:floodsystem@localhost:5432/floodsystem   # matches docker-compose.yml POSTGRES_USER/PASSWORD
REDIS_URL=redis://localhost:6379/0

# ---- Target site (for river-stage nearest-station lookup) ----
TARGET_SITE_LAT=
TARGET_SITE_LON=
