# ---- WeatherNext 2 Cyclones Mini (regional ensemble weather forecast) ----
# Manually exported from wn2_demo.ipynb (Colab) and copied here ahead of
# time; the backend never runs inference itself. See
# data/wn2_mini/README.md for the confirmed export pipeline.
WN2_MINI_FORECAST_PATH=./data/wn2_mini/tn_flood_forecast.nc

# ---- CWC / India-WRIS (river & reservoir stage forecast) ----
# Confirmed in T1A.6: National Water Data Portal is a CKAN instance at this
# base URL (its /api/3/action/... Action API). Blank falls through to the
# same default in config.py.
CWC_DATA_PORTAL_BASE_URL=https://nwdp.nwic.gov.in
# indiawris.gov.in resolves (164.100.85.36) but every TCP connection to it
# times out from this dev environment (tested against /reservoir_stations,
# /rp_stations, /gwl_stations, /gwq_stations, /swq_stations -- likely a
# geo/IP-level block, not a credentials problem). Left unconfirmed, not
# assumed; leave blank unless you can reach it and confirm a real response
# shape.
INDIA_WRIS_BASE_URL=

# ---- Storage ----
DATABASE_URL=postgresql://localhost:5432/floodsystem
REDIS_URL=redis://localhost:6379/0

# ---- Target site (for river-stage nearest-station lookup) ----
TARGET_SITE_LAT=
TARGET_SITE_LON=
