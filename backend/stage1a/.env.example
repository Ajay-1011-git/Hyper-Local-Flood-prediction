# ---- GenCast (regional ensemble weather forecast) ----
GENCAST_WEIGHTS_PATH=            # path or URL to published GenCast weights
GENCAST_TPU_ENDPOINT=            # TPU/JAX inference endpoint, if using remote compute
GENCAST_PRECOMPUTED_FALLBACK_DIR=./data/gencast_precomputed  # local cache/fallback forecasts

# ---- CWC / India-WRIS (river & reservoir stage forecast) ----
# Confirmed in T1A.6: National Water Data Portal is a CKAN instance at this
# base URL (its /api/3/action/... Action API). Blank falls through to the
# same default in config.py.
CWC_DATA_PORTAL_BASE_URL=https://nwdp.nwic.gov.in
# indiawris.gov.in was unreachable from this dev session (connection
# refused) -- left unconfirmed, not assumed. Leave blank.
INDIA_WRIS_BASE_URL=

# ---- Storage ----
DATABASE_URL=postgresql://localhost:5432/floodsystem
REDIS_URL=redis://localhost:6379/0

# ---- Target site (for river-stage nearest-station lookup) ----
TARGET_SITE_LAT=
TARGET_SITE_LON=

# ---- WeatherNext 2 Cyclones Mini (T1A.2 amendment) ----
# Manually exported from wn2_demo.ipynb (Colab) and copied here ahead of
# time; the backend never runs inference itself. See gencast_amendment
# doc for the confirmed export pipeline.
WN2_MINI_FORECAST_PATH=./data/wn2_mini/tn_flood_forecast.nc
