// Copy this file to secrets.h (gitignored — see repo root .gitignore's
// firmware/**/secrets.h rule) and fill in real values. Never commit
// secrets.h itself.

#pragma once

#define WIFI_SSID "your-hotspot-ssid"
#define WIFI_PASSWORD "your-hotspot-password"

// Base URL of the Stage 1B FastAPI server's sensor ingestion endpoint,
// reachable from the ESP32's WiFi network (e.g. the presenter's laptop
// on the same hotspot, matching backend/stage1b/routes.py's
// POST /api/sensor/reading).
#define SERVER_URL "http://192.168.1.100:8011/api/sensor/reading"

// Must match SENSOR_INGEST_TOKEN in backend/stage1b/.env.
#define SENSOR_TOKEN "dev-local-sensor-token-change-me"

// This unit's sensor_id (must be a stable identifier — the server side
// treats (sensor_id, timestamp) as the idempotency key, per T1B.1).
#define SENSOR_ID "esp32-vellore-demo-01"
