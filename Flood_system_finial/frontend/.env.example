# Each of this project's five stages runs as its OWN independent FastAPI
# process on its own port (a real, deliberate architecture decision -- see
# src/api/client.ts's module docstring). There is no single API base URL
# that serves all of them; a real deployment would front them with one
# gateway/reverse-proxy and collapse these.
#
# The defaults below are the real localhost ports this project's own
# VERIFY runs have actually used -- override as needed.
VITE_STAGE1A_BASE_URL=http://127.0.0.1:8001
VITE_STAGE1B_BASE_URL=http://127.0.0.1:8011
VITE_STAGE2_BASE_URL=http://127.0.0.1:8765
VITE_STAGE3_BASE_URL=http://127.0.0.1:8003
VITE_STAGE4_BASE_URL=http://127.0.0.1:8004

# WebSocket relay. NOTE (see src/api/websocket.ts): /ws/site/{site_id} is
# currently implemented SEPARATELY by Stage 1B and Stage 2, each with only
# a partial view of the event stream. This points at Stage 2's, which
# emits simulation_update + sensor_assimilated (the events the 3D scene
# actually needs).
VITE_WS_BASE_URL=ws://127.0.0.1:8765

# The single demo site this deployment serves.
VITE_SITE_ID=vit-vellore
