DATABASE_URL=postgresql://localhost:5432/floodsystem
REDIS_URL=redis://localhost:6379/0
SACHET_SCHEMA_VERSION=1.2           # real OASIS CAP version SACHET uses (confirmed T4A.1: SACHET uses plain, unmodified CAP 1.2 -- no custom schema)
SUPPORTED_LANGUAGES=en,ta,hi,te,ml,kn   # English + Tamil at minimum (PRD NFR-6); Hindi/Telugu/Malayalam/Kannada added per project-owner request, real Sarvam-supported codes

# ---- Sarvam AI (multilingual text/TTS, T4A.2) ----
SARVAM_API_KEY=                     # your Sarvam AI API key -- NEVER commit a real value here, this file ships blank

# ---- T4B.0: CORS (real browser origins allowed to call this API) ----
# Explicit allowlist, never "*". Defaults to the real Vite dev-server
# origins this project uses.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
