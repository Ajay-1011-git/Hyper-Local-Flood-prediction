# ---- Bhuvan / NRSC (DEM) ----
# Confirmed in T1B.2: Bhuvan's legacy portal has no scriptable download path
# (WMS/WMTS = tiles only, raw raster is a login-gated manual browser flow).
# Real access path is NRSC's Bhoonidhi geoportal REST API.
BHUVAN_ACCESS_METHOD=bhoonidhi_api
BHUVAN_DEM_PRODUCT=CartoDEM      # per project's confirmed DEM source
BHOONIDHI_BASE_URL=https://bhoonidhi-api.nrsc.gov.in
BHOONIDHI_USER_ID=               # your bhoonidhi.nrsc.gov.in account userId — NEVER commit a real value here, this file ships blank
BHOONIDHI_PASSWORD=              # your bhoonidhi.nrsc.gov.in account password — NEVER commit a real value here, this file ships blank
BHOONIDHI_DEM_COLLECTION=CartoSat-1_PAN_CartoDEM_30m

# ---- TN WRD (rainfall calibration) ----
TNWRD_DATASET_URL=https://nwdp.nwic.gov.in/dataset/rainfall-telemetry-hourly-tamil-nadu-sw-gw
# ^ confirmed to exist; verify exact CSV schema in T1B.4 before parsing

# ---- Storage ----
DATABASE_URL=postgresql://floodsystem:floodsystem@localhost:5432/floodsystem   # matches docker-compose.yml POSTGRES_USER/PASSWORD
REDIS_URL=redis://localhost:6379/0
DEM_RASTER_STORAGE_DIR=./data/dem

# ---- Target site ----
# 2026-08-20: standardized to "vit-vellore" + the real GLB-surveyed
# anchor coordinates across all stages -- see config.py's comment for
# the full reasoning. Blank here (like other config defaults in this
# file) still resolves to config.py's real default; set explicitly only
# to override.
TARGET_SITE_ID=vit-vellore
TARGET_SITE_LAT=12.969223
TARGET_SITE_LON=79.155934

# ---- Sensor ingestion ----
SENSOR_INGEST_TOKEN=             # simple shared-secret auth for the ESP32's POST requests
